{
  "name": "pangil-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/deploy.mts && next build",
    "release": "node scripts/release.mts",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env --import ./scripts/aliasHook.mts scripts/migrate-tistory/report.mts",
    "migrate:load": "node --env-file-if-exists=.env --import ./scripts/aliasHook.mts scripts/migrate-tistory/load.mts",
    "migrate:verify": "node --env-file-if-exists=.env --import ./scripts/aliasHook.mts scripts/migrate-tistory/verify.mts",
    "icons": "node --import ./scripts/aliasHook.mts scripts/icons/build.mts",
    "crawl": "node --env-file-if-exists=.env --import ./scripts/aliasHook.mts scripts/crawler/run.mts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "prepare": "husky",
    "db:deploy": "prisma migrate deploy",
    "content:sermon-title": "node --env-file-if-exists=.env --import ./scripts/aliasHook.mts scripts/content-migrations/001-sermon-title.mts",
    "content:tech-slug": "node --env-file-if-exists=.env --import ./scripts/aliasHook.mts scripts/content-migrations/002-tech-index-slug.mts",
    "content:faith-slug": "node --env-file-if-exists=.env --import ./scripts/aliasHook.mts scripts/content-migrations/003-faith-index-slug.mts"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/extension-heading": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extensions": "3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "satori": "^0.33.3",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
