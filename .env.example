# ─────────────────────────────────────────────────────────────
# .env.example — 묵상+기술 통합 블로그
# 실제 값은 커밋하지 않는다. dev = 로컬 .env / prod = Vercel 환경변수 /
# 크롤러 = GitHub Actions Secrets. (AGENTS.md "절대 하지 말 것")
# ─────────────────────────────────────────────────────────────

# ── Supabase / DB (Prisma 이중 URL — 08 §2) ──
# pooled(pgbouncer, 6543) = 런타임 쿼리
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true"
# direct(5432) = prisma migrate 전용
DIRECT_URL="postgresql://postgres.[ref]:[password]@[host]:5432/postgres"

# ── Supabase Auth / API ──
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""      # 공개 anon 키 (클라 노출 전제이나 이 프로젝트는 서버 전담)
SUPABASE_SERVICE_ROLE_KEY=""          # 서버 전용. 절대 클라/크롤러에 부여 금지 (05 §3.3)
ADMIN_EMAIL=""                        # 단일 관리자 계정 이메일. 이 주소만 /admin 통과 (05 §3.2)

# ── 사이트 URL (도메인 미확정 → env 주입, 08 §3) ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # 배포 시 루트 도메인으로 교체
# 서브도메인 매핑도 하드코딩 금지 (dev./faith. 또는 tech./faith.)
# middleware 3호스트 분기용 실제 호스트. Vercel에 명시 등록하는 3개(와일드카드 불사용, 04 §1.3).
# 미설정 시 middleware는 서브도메인 라벨(dev./faith.) 폴백으로 동작한다.
SITE_HOST_ROOT=""                     # 예: pangil.me
SITE_HOST_DEV=""                      # 예: dev.pangil.me
SITE_HOST_FAITH=""                    # 예: faith.pangil.me
# 로컬·Vercel 기본 주소에서는 ?site=hub|dev|faith 쿼리로 3면을 전환한다(08 §3)

# ── 허브 프로필 (H-01, 01 §3.3) ──
# 비어 있으면 그 줄을 그리지 않는다. 브랜드명은 출시 게이트(07 §4)라 기본값을 두지 않는다.
NEXT_PUBLIC_PROFILE_NAME=""            # 예: 광일
NEXT_PUBLIC_PROFILE_TAGLINE=""         # 한 줄 소개
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# ── 통계 수집 (05 §4, M6) ──
# visitorHash의 고정 솔트. 없으면 수집하지 않는다(익명성이 설계의 일부라 평문 해시를 남기지
# 않는다). 값 생성: openssl rand -hex 32
STAT_SALT=""
# rate limit용 Upstash Redis(무료). 없으면 상한 없이 수집하고 서버 로그에 경고를 남긴다.
# upstash.com → Redis DB 생성 → REST API 탭의 두 값
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── 크롤러 (GitHub Actions Secrets) ──
QT365_ID=""                           # 365qt 로그인 (Actions에만)
QT365_PW=""
CRAWLER_INGEST_TOKEN=""               # /api/crawler/ingest 스코프 토큰 (DRAFT 생성 전용)
INGEST_URL=""                         # 보고 대상 앱 주소. 예: https://pangil.me (Actions Secrets)
# 로컬에서 `npm run crawl -- --dry-run`을 돌려볼 때만 QT365_*를 .env에 둔다(.env는 커밋 대상이 아니다).
# 자격증명 없이 파이프라인만 보려면 --fixture=scripts/crawler/fixtures/todayqt-2026-08-24.html

# ── watchdog / 크론 (Vercel) ──
CRON_SECRET=""                        # Vercel Cron 호출 검증 Bearer

# ── 통계 (05 §4) ──
STAT_SALT=""                          # visitorHash 고정 솔트 (일일 로테이션의 base)

# ── rate limit (Upstash, 05 §4.3) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── 알림 (Slack, 06) ──
SLACK_WEBHOOK_URL=""                  # 크롤러/watchdog 실패 알림. 서버(Vercel env)에만
# 성공·미게시 알림까지 받고 싶을 때만 on. 기본은 실패만 알린다 —
# 매일 아침 오는 🟢를 읽지 않게 되면 정작 🔴도 흘려버린다(프리모템 #1)
SLACK_VERBOSE=""                      # on | (비움)
