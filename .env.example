# ─────────────────────────────────────────────────────────────
# .env.example — 묵상+기술 통합 블로그
# 실제 값은 커밋하지 않는다. dev = 로컬 .env / prod = Vercel 환경변수 /
# 크롤러 = GitHub Actions Secrets. (AGENTS.md "절대 하지 말 것")
# ─────────────────────────────────────────────────────────────

# ── Supabase / DB (Prisma 이중 URL — 08 §2) ──
# pooled(pgbouncer, 6543) = 런타임 쿼리
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true"
# direct(5432) = prisma migrate 전용
DIRECT_URL="postgresql://postgres.[ref]:[password]@[host]:5432/postgres"

# ── Supabase Auth / API ──
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""      # 공개 anon 키 (클라 노출 전제이나 이 프로젝트는 서버 전담)
SUPABASE_SERVICE_ROLE_KEY=""          # 서버 전용. 절대 클라/크롤러에 부여 금지 (05 §3.3)

# ── 사이트 URL (도메인 미확정 → env 주입, 08 §3) ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # 배포 시 루트 도메인으로 교체
# 서브도메인 매핑도 하드코딩 금지 (dev./faith. 또는 tech./faith.)

# ── 크롤러 (GitHub Actions Secrets) ──
QT365_ID=""                           # 365qt 로그인 (Actions에만)
QT365_PW=""
CRAWLER_INGEST_TOKEN=""               # /api/crawler/ingest 스코프 토큰 (DRAFT 생성 전용)

# ── watchdog / 크론 (Vercel) ──
CRON_SECRET=""                        # Vercel Cron 호출 검증 Bearer

# ── 통계 (05 §4) ──
STAT_SALT=""                          # visitorHash 고정 솔트 (일일 로테이션의 base)

# ── rate limit (Upstash, 05 §4.3) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── 알림 (Slack, 06) ──
SLACK_WEBHOOK_URL=""                  # 크롤러/watchdog 실패 알림. 서버(Vercel env)에만
